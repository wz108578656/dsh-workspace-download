{
  "name": "dsh-workspace-download",
  "version": "0.1.0",
  "description": "在 DSH 会话标题栏下载当前工作区的文件：单个文件直下，多个文件打包成 zip",
  "author": "zhuo.wang (wz108578656)",
  "homepage": "https://github.com/wz108578656/dsh-workspace-download#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wz108578656/dsh-workspace-download.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/wz108578656/dsh-workspace-download/issues"
  },
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "download",
    "zip"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
